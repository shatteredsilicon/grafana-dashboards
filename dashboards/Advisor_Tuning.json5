            "type": "prometheus"
          },
          "datasourceErrors": {},
          "errors": {},
          "expr": "mysql_info_schema_table_count{instance=~\"$host\"}",
          "format": "time_series",
          "interval": "$interval",
          "intervalFactor": 1,
          "legendFormat": "Count",
          "metric": "",
          "refId": "A",
          "step": 300
        }
      ],
      "title": "Table Count",
      "description": "Note: If these graphs are empty, check that you have: ``info_schema.tables.databases = *`` and ``info_schema.tables = 1`` set in your mysqld_exporter.conf",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 4
      },
      "queryThresholds": "A,B",
      "colors": [
        "rgb(24, 27, 31)",
        "rgba(237, 129, 40, 0.89)",
        "rgba(36, 112, 33, 0.97)"
      ],
      "valueFontSize": "150%",
      "colorBackground": true,
      "exactThreshold": true,
      "thresholdQuery": "C",
      "hideTimeOverride": false,
      "interval": "$interval",
      "links": [],
      "maxDataPoints": 100,
      "pluginVersion": "9.5.7",
      "valueMaps": [
        {
          "op": "=",
          "text": "N/A",
          "value": "-1"
        }
      ],
      "targets": [
        {
          "calculatedInterval": "2m",
          "datasource": {
            "type": "prometheus"
          },
          "datasourceErrors": {},
          "errors": {},
          "expr": "mysql_global_variables_table_definition_cache{instance=~\"$host\"} or vector(-1)",
          "format": "time_series",
          "interval": "$interval",
          "instant": true,
          "intervalFactor": 1,
          "legendFormat": "",
          "metric": "",
          "refId": "A",
          "step": 300
        },
        {
          "calculatedInterval": "2m",
          "datasource": {
            "type": "prometheus"
          },
          "datasourceErrors": {},
          "errors": {},
          "expr": "\
clamp( \n\
  vector(400) and on() ( \n\
    mysql_info_schema_table_count{instance=~\"$host\"} < (400 * 0.9) \n\
  ) \n\
  or on() ( \n\
    2^( \n\
      floor( \n\
        log2(mysql_info_schema_table_count{instance=~\"$host\"}) \n\
      ) + 1 \n\
    ) \n\
    and on() ( \n\
      mysql_global_variables_table_definition_cache{instance=~\"$host\"} \n\
      / \n\
      2^( \n\
        floor( \n\
          log2(mysql_info_schema_table_count{instance=~\"$host\"}) \n\
        ) + 1 \n\
      ) \n\
      < 0.9 \n\
    ) \n\
  ) \n\
  or on() 2^( \n\
    floor( \n\
      log2(mysql_info_schema_table_count{instance=~\"$host\"}) \n\
    ) + 2 \n\
  ), \n\
  400, \n\
  2097152 \n\
) \n\
",
          "format": "time_series",
          "interval": "$interval",
          "instant": true,
          "intervalFactor": 1,
          "legendFormat": "",
          "metric": "",
          "refId": "B",
          "step": 300
        },
        {
          "calculatedInterval": "2m",
          "datasource": {
            "type": "prometheus"
          },
          "datasourceErrors": {},
          "errors": {},
          "expr": "\
mysql_global_variables_table_definition_cache{instance=~\"$host\"} \n\
and on() ( \n\
  mysql_info_schema_table_count{instance=~\"$host\"} >= 0 \n\
) \n\
or on() vector(-2) \n\
",
