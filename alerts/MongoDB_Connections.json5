{
  "condition": "B",
  "data": [
    {
      "refId": "A",
      "queryType": "",
      "relativeTimeRange": {
        "from": 300,
        "to": 0
      },
      "datasourceUid": "{{ .DatasourceUID }}",
      "model": {
        "expr": "\
( \n\
  ( \n\
    mongodb_mongod_connections{instance=~\"{{ .Instance }}\", state=\"current\"} \n\
    or \n\
    mongodb_mongos_connections{instance=~\"{{ .Instance }}\", state=\"current\"} \n\
  ) / on(instance, job, region) ( \n\
    mongodb_mongod_connections{instance=~\"{{ .Instance }}\", state=\"available\"} \n\
    or \n\
    mongodb_mongos_connections{instance=~\"{{ .Instance }}\", state=\"available\"} \n\
  ) \n\
) * 100 \n\
",
        "hide": false,
        "intervalMs": 1000,
        "maxDataPoints": 43200,
        "refId": "A",
        "legendFormat": "% of Max",
        "datasource": {
          "type": "prometheus",
          "uid": "{{ .DatasourceUID }}"
        }
      }
    },
    {
      "refId": "B",
      "queryType": "",
      "relativeTimeRange": {
        "from": 0,
        "to": 0
      },
      "datasourceUid": "-100",
      "model": {
        "conditions": [
          {
            "evaluator": {
              "params": [80],
              "type": "gt"
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": ["A"]
            },
            "reducer": {
              "params": [],
              "type": "avg"
            },
            "type": "query"
          }
        ],
        "datasource": {
          "type": "__expr__",
          "uid": "-100"
        },
        "hide": false,
        "intervalMs": 1000,
        "maxDataPoints": 43200,
        "refId": "B",
        "type": "classic_conditions"
      }
    }
  ],
  "for": "5m",
  "ruleGroup": "{{ .Instance }}",
  "title": "MongoDB Connections - {{ .Instance }}",
  "uid": "ssm-mongodb-connections-{{ .Instance }}",
  "dashboardUID": "ssm-health-check",
