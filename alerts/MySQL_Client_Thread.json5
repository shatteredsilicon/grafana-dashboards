{
  "condition": "B",
  "data": [
    {
      "refId": "A",
      "queryType": "",
      "relativeTimeRange": {
        "from": 300,
        "to": 0
      },
      "datasourceUid": "{{ .DatasourceUID }}",
      "model": {
        "expr": "\
avg_over_time(mysql_global_status_threads_running{instance=~\"{{ .Instance }}\"}[5m]) - scalar( \n\
  count( \n\
    ( \n\
      node_cpu{instance=~\"{{ .Instance }}\",mode=~\"user\"} \n\
      or \n\
      node_cpu_seconds_total{instance=~\"{{ .Instance }}\",mode=~\"user\"} \n\
    ) \n\
  ) \n\
  or \n\
  sum(rdsosmetrics_General_numVCPUs{instance=~\"{{ .Instance }}\"}) \n\
  or \n\
  count(hrProcessorLoad{instance=~\"{{ .Instance }}\"}) \n\
) * 2 \n\
",
        "hide": false,
        "intervalMs": 1000,
        "maxDataPoints": 43200,
        "refId": "A",
        "legendFormat": "Avg Threads Running",
        "datasource": {
          "type": "prometheus",
          "uid": "{{ .DatasourceUID }}"
        }
      }
    },
    {
      "refId": "B",
      "queryType": "",
      "relativeTimeRange": {
        "from": 0,
        "to": 0
      },
      "datasourceUid": "-100",
      "model": {
        "conditions": [
          {
            "evaluator": {
              "params": [0],
              "type": "gt"
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": ["A"]
            },
            "reducer": {
              "params": [],
              "type": "last"
            },
            "type": "query"
          }
        ],
        "datasource": {
          "type": "__expr__",
          "uid": "-100"
        },
        "hide": false,
        "intervalMs": 1000,
        "maxDataPoints": 43200,
        "refId": "B",
        "type": "classic_conditions"
      }
    }
  ],
  "for": "5m",
  "ruleGroup": "{{ .Instance }}",
  "title": "MySQL Client Thread Activity - {{ .Instance }}",
  "uid": "ssm-mysql-client-thread-activity-{{ .Instance }}",
  "dashboardUID": "ssm-health-check",
  "panelID": 3
}