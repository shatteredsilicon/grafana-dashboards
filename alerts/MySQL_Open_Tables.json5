        "expr": "\
( \n\
  rate(mysql_global_status_table_open_cache_hits{instance=~\"$host\"}[1m]) \n\
  or \n\
  rate(mysql_global_status_table_open_cache_hits_total{instance=~\"$host\"}[1m]) \n\
) / (  \n\
  ( \n\
    rate(mysql_global_status_table_open_cache_hits{instance=~\"$host\"}[1m]) \n\
    or \n\
    rate(mysql_global_status_table_open_cache_hits_total{instance=~\"$host\"}[1m]) \n\
  ) + ( \n\
    rate(mysql_global_status_table_open_cache_misses{instance=~\"$host\"}[1m]) \n\
    or \n\
    rate(mysql_global_status_table_open_cache_misses_total{instance=~\"$host\"}[1m]) \n\
  ) \n\
) * 100 \n\
",
        "hide": false,
        "intervalMs": 1000,
        "maxDataPoints": 43200,
        "refId": "A",
        "legendFormat": "Table Open Cache Hit Ratio",
