    "prebuild": "rm -rf dist/ && mkdir dist/ && cp -r ../alerts ./src/ && node convert-dashboards.js && cp -RH src/* dist/ && rm -f dist/dashboards/*.json5 && rm -f dist/alerts/*.json5",
